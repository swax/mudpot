# Reference only: the Go binary does not automatically load .env files.
# For Linux services, use deploy/honeypot.env and deploy/dashboard.env separately.
MUDPOT_PORT=:2222,:8081
MUDPOT_SSH_PORT=:2223
MUDPOT_TLS_PORT=:8443
MUDPOT_ADVENTURE=adventures/default
MUDPOT_STATE=data/state
MUDPOT_LOG=data/events.jsonl
# Optional shared path for both processes; default is MUDPOT_LOG + .sqlite.
# MUDPOT_HISTORY=data/events.jsonl.sqlite

# Private dashboard process only. Never bind this to a public interface.
MUDPOT_DASHBOARD_ADDR=127.0.0.1:8080
# Optional local MaxMind Country + ASN databases, auto-detected when present.
MUDPOT_GEOIP_DIR=data/geoip
# Set a long random value to require browser password / bearer authentication.
# MUDPOT_DASHBOARD_TOKEN=
