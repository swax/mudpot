MUDPOT_DASHBOARD_ADDR=127.0.0.1:8080
MUDPOT_LOG=/var/log/mudpot/events.jsonl
MUDPOT_GEOIP_DIR=/opt/mudpot/data/geoip
# Persistent history defaults to /var/log/mudpot/events.jsonl.sqlite.
# If overriding MUDPOT_HISTORY, set the same path in honeypot.env.
# Optional: set a long random password; use SSH tunneling for remote access.
# MUDPOT_DASHBOARD_TOKEN=
